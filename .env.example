# Postgres connection string. Vercel sets this (or DATABASE_URL) when a
# database is connected to the project. For local development, copy this file
# to .env.local, fill it in, then run `pnpm db:migrate`.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000/api/auth
# Email (https://resend.com). Without these the site still works, but no email is sent.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. Wilson's Wires <office@wilsonswires.com>
EMAIL_FROM=
# Optional: where to send a notice when a new client signs up. Also used as the reply-to on confirmations.
EMAIL_NOTIFY_TO=

# Optional: the address the site is served from, used in emailed links, e.g. https://wilsonswires.com
# Leave empty on Vercel to use the deployment's own address.
SITE_URL=
