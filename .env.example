# Copy to .env.local for local development.
# Production values are set in the Vercel dashboard.

# Google Analytics measurement ID (read in app/layout.tsx)
GOOGLE_ANALYTICS=

# Postgres connection string. Vercel sets this (or DATABASE_URL) when a
# database is connected to the project. After filling it in locally, run
# `pnpm db:migrate` to create or update the tables.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Auth (not used yet)
# `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000/api/auth
