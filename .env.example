# Copy to .env.local for local development.
# Production values are set in the Vercel dashboard.

# Google Analytics measurement ID (read in app/layout.tsx)
GOOGLE_ANALYTICS=

# Postgres (not used yet; kept for upcoming database features)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Auth (not used yet)
# `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000/api/auth
